# ============================================================
# Pluvus Workflow Prototype — Environment Variables (example)
# Copy this file to .env and fill in real values for local dev.
# .env is gitignored; this committed example carries no secrets.
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development
# Which components this process runs (HARD-A1 split topology). Default "all" is
# the single-process dev behavior (API + workers + scheduler in one). A split
# deploy runs separate processes: PROCESS_ROLE=api | worker | scheduler. Run
# exactly ONE scheduler (it's the single leader). See start:api|worker|scheduler.
PROCESS_ROLE=all
# Per-worker BullMQ concurrency (HARD-S1). Each in-flight step holds a slot for a
# 45-120s LLM call, so size these to the agent service's real capacity, not a
# constant. WORKER_CONCURRENCY is the default for both workers (default 5); the
# per-queue overrides win when set.
WORKER_CONCURRENCY=5
# NODE_EXECUTION_CONCURRENCY=
# INBOUND_EMAIL_CONCURRENCY=
# W-4: opt-in gate for the queue-injection endpoints (POST /queues/node-execution,
# POST /queues/inbound-email). These enqueue REAL jobs that drive the live state
# machine — inbound-email can force a mockIntent (a fabricated creator reply) —
# so they answer 404 unless NODE_ENV=test or this is explicitly "true" on a
# trusted local dev/harness box. NEVER set in a deployed environment.
ENABLE_QUEUE_INJECTION=false

# --- Database (Phase 2) ---
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Redis (Phase 4+) ---
# Redis URL for BullMQ and the per-instance locks.
REDIS_URL=redis://localhost:6379

# --- Scheduler leader election (W-8) ---
# When more than one PROCESS_ROLE=scheduler process runs, a Redis leader lease
# ensures only ONE actually polls/reconciles — so a duplicate scheduler cannot
# double-fire executors and burn duplicate LLM spend (OCC + sendOnce already
# block duplicate transitions/emails; this removes the wasted compute). The lease
# must comfortably exceed one 30s poll cycle; it is renewed every cycle.
SCHEDULER_LEADER_TTL_MS=90000

# --- Randomized send delay (Randomized Send Delay spec) ---
# Decouples "an AI reply is generated" from "the reply is sent" by a randomized
# delay, so negotiation counters/acceptances/close emails don't land microseconds
# after the creator's email (a strong "automated sender" deliverability signal).
# Applies ONLY to AI-generated negotiation replies — outreach, follow-ups, and
# transactional emails (brief PDF, payout form, handoff) still send immediately.
#
# The delay is a BullMQ-native delayed job (Redis holds the timer, survives a
# restart); the send still flushes through the delayed-send queue+worker, so that
# worker runs at EVERY worker-startup site. IMPORTANT: SEND_DELAY_ENABLED=false is
# DELAY-0, not a synchronous bypass — the send still routes through the queue, so
# the delayed-send worker MUST be running even when this is false.
#
# Master switch. false → all AI replies flush with delay 0 (immediately).
SEND_DELAY_ENABLED=true
# Lower/upper bounds of the uniform random window (ms). Default 30s–5min.
# If MIN > MAX the feature is treated as disabled (fail safe = send immediately).
SEND_DELAY_MIN_MS=30000
SEND_DELAY_MAX_MS=300000
# Poller safety-net (§4.4): reclaims a reserved-but-unsent reply whose delayed job
# was lost from Redis. GRACE is extra time past MAX before the sweep touches a
# reservation — it MUST exceed the worst-case reserve→enqueue lag (the enqueue
# happens after the OCC commit), or the sweep could race a still-pending job.
SEND_DELAY_SWEEP_GRACE_MS=120000
# Upper age bound (ms): a reservation older than this is a poison message — the
# sweep stops re-driving it and leaves it for manual inspection. Default 24h.
SEND_DELAY_MAX_SWEEP_AGE_MS=86400000
# Max times the sweep re-enqueues one reservation before giving up (poison-loop
# bound). Default 3.
SEND_DELAY_MAX_REDRIVES=3
# Optional: per-worker concurrency for the delayed-send worker (falls back to
# WORKER_CONCURRENCY, default 5). A delayed flush is a fast provider send, not a
# 45-120s LLM call, so it can be higher than the node-execution concurrency.
# DELAYED_SEND_CONCURRENCY=10

# --- Agent service ---
# URL of the Python LangGraph agent service (TS providers read AGENT_SERVICE_URL).
AGENT_SERVICE_URL=http://localhost:8001
# Route classification + negotiation through the real LangGraph agent (no mock).
#   mock     → in-process rule/keyword providers (harness only)
#   langgraph → HTTP to the agent service above (real AI)
AGENT_PROVIDER=langgraph
NEGOTIATION_PROVIDER=langgraph
# Shared secret protecting /classify, /negotiate, /draft on the agent service
# (FIX-12). The TS providers send it as `Authorization: Bearer <key>`; the agent
# service checks it against AGENT_API_KEY. Leave BOTH unset for local dev /
# harnesses (auth disabled, a warning is logged). Set the SAME value on both
# sides in any deployed environment.
AGENT_API_KEY=
# Deployment environment for the agent service (W-9). When set to prod/production/
# staging AND AGENT_API_KEY is empty, the auth dependency FAILS CLOSED (503) rather
# than silently serving the money-path endpoints unauthenticated. Leave unset in
# local dev / harnesses to keep the no-op-when-key-unset behavior.
AGENT_ENV=
# Per-request timeout (ms) the TS side applies to the GENERATION routes
# (/negotiate, /draft). Default 120000 (C3). This MUST exceed the Python side's
# per-invoke budget × retries, or the HTTP request is aborted before the model
# finishes generating: a local Qwen call is ~38s, and a generation + one repair
# retry can take ~80s. The prior 30000 aborted before even the first generation
# completed, tripping the breaker and dumping every turn to MANUAL_REVIEW.
AGENT_TIMEOUT_MS=120000
# Shorter fail-fast timeout (ms) for the /classify route only (default 45000).
# Classification is a single short generation on the interactive reply path, so
# it should not hold a worker as long as a full draft — but still above one Qwen
# call (~38s) so a normal classify completes.
AGENT_CLASSIFY_TIMEOUT_MS=45000
# Circuit breaker (FIX-9): after AGENT_CB_FAILURE_THRESHOLD consecutive failures
# the TS side stops calling the agent service and fast-fails for
# AGENT_CB_COOLDOWN_MS, then allows one probe. While the circuit is open the
# orchestration degrades to MANUAL_REVIEW (classify→UNKNOWN, negotiate→escalate)
# instead of hammering a dead backend. Defaults 5 / 30000.
AGENT_CB_FAILURE_THRESHOLD=5
AGENT_CB_COOLDOWN_MS=30000
# Python-side per-invoke wall-clock budget (seconds). Bounds a hung llm.invoke so
# it can't pin the FastAPI worker even though the TS request already aborted.
# Set 0 to disable. Default 60 (FIX-9).
LLM_INVOKE_TIMEOUT_SECONDS=60
# Rate limit on the agent service: max requests per window per client+route, and
# the window length in seconds. Set AGENT_RATE_LIMIT=0 to disable. Default 60/60s.
AGENT_RATE_LIMIT=60
AGENT_RATE_WINDOW_SECONDS=60

# --- Server rate limiting (BUG-SEC1) ---
# Two buckets on the Express server. GLOBAL applies to every request (generous,
# catches floods). PUBLIC is tighter and applies to the unauthenticated
# magic-link/webhook/redirect routes (/webhooks, /payment, /t, /attribution,
# /payout). Windows are in MILLISECONDS. Set a *_MAX to 0 to disable that bucket
# (e.g. for load tests). Over-limit returns a clean 429 JSON body.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# --- Nylas (Phase 6) ---
# Email provider selector: "mock" (default, no real email) or "nylas".
# Leave as mock for local dev / harnesses; flip to nylas in a sandbox env.
EMAIL_PROVIDER=nylas
# Nylas API credentials. Required only when EMAIL_PROVIDER=nylas.
NYLAS_API_KEY=
NYLAS_GRANT_ID=
# Webhook signing secret (the webhook_secret Nylas returns when you create the
# webhook destination). Used to verify the X-Nylas-Signature header on inbound
# deliveries. Required for the /webhooks/nylas route to accept events.
NYLAS_WEBHOOK_SECRET=
# Optional: API base URI override (e.g. https://api.us.nylas.com).
NYLAS_API_URI=
# --- Gmail Campaign Labels (feature: gmail-campaign-labels) ---
# When "true", every outbound for a campaign applies a real Gmail label
# "Pluvus/<Campaign name>" to the conversation thread (via Nylas folders), so the
# operator can navigate all of a campaign's threads from Gmail's label sidebar.
# Best-effort + post-send: a labeling failure NEVER blocks or fails delivery.
# Default "false" (ship dark). Requires:
#   1. EMAIL_PROVIDER=nylas with a GOOGLE/Gmail grant, and
#   2. the grant consented with Gmail mail-MODIFY scope (a read/send-only grant
#      just no-ops with a logged warning — the send still delivers).
# Flip to "true" only after both are confirmed in the target environment.
GMAIL_LABELS_ENABLED=false
# Parent label namespace (the nesting parent in Gmail's sidebar). Default "Pluvus"
# → labels look like "Pluvus/Summer Skincare". Change to re-namespace all labels.
GMAIL_LABEL_PREFIX=Pluvus
# Webhook replay-freshness window in SECONDS (BUG-SEC4). A signed delivery whose
# Nylas `time` is older (or more than this in the future) is rejected as a replay.
# Default 300 (5 min). Set 0 to disable the freshness check (the seen-delivery-id
# guard still drops exact-duplicate deliveries).
WEBHOOK_MAX_AGE_SECONDS=300

# --- Fail-closed override (BUG-SEC3) ---
# Unset secrets/keys (ATTRIBUTION_WEBHOOK_SECRET, OPERATOR_API_KEY) run in an OPEN
# posture ONLY when NODE_ENV is exactly "development" or "test". Every other
# environment (production, staging, preview, or an unset/typo'd NODE_ENV) FAILS
# CLOSED: those routes 401 and the server refuses to boot when a required secret
# is missing — so a mis-set env can never boot the money/data surface wide open.
# Set this to "true" to deliberately re-open the posture in a non-dev/test env
# (e.g. a throwaway internal staging box). Leave unset everywhere else.
ALLOW_OPEN_SECRETS=

# --- Attribution (Phase 2) ---
# Shared secret our product sends as X-Attribution-Secret on the conversion webhook.
# Optional in local dev / harnesses (a one-time startup warning is logged, same as
# AGENT_API_KEY). Set the SAME value on both the product side and here in any
# deployed environment to prevent unauthenticated conversion injection.
# P1: REQUIRED in production — the server refuses to boot (exits) when
# NODE_ENV=production and this is unset, rather than silently accept fake sales.
ATTRIBUTION_WEBHOOK_SECRET=

# --- Operator route gate (P2 / single-operator go-live) ---
# Shared secret the web dashboard sends as X-Operator-Key to reach the operator
# money/data routes (/payouts, /campaigns, /partnerships, /observability,
# /manual-queue, /workflows, /creators, /uploads, /queues). Creator/webhook
# routes (/webhooks, /payment, /t, /attribution, /payout/confirm|dispute) stay
# OPEN — a creator's magic link is never gated. Optional in local dev; set in any
# exposed environment. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPERATOR_API_KEY=

# --- Manual queue escalation notices (Phase 11) ---
# When a creator is escalated to the manual review queue, the brand is emailed so
# a human can take over. Recipient precedence:
#   1. the campaign's notifyEmail (set per-campaign in the wizard)
#   2. BRAND_NOTIFY_EMAIL below (workspace-wide default)
#   3. the platform operator address (affiliatepartner@pluvus.com) as a last resort
# Leave blank to fall through to the operator default.
BRAND_NOTIFY_EMAIL=

# --- Public base URL (P3) ---
# The stable public origin creator links are minted from AT SEND TIME (payment
# form, payout confirm/dispute, /t tracking) and the Nylas webhook is registered
# against. MUST match the live tunnel/host or mailed links 404. The tunnel
# launcher (scripts/tunnel.mjs) keeps this in sync for the interim quick tunnel;
# set it once to the stable host on the real deploy. See readme_docs/ops/STABLE_URL.md.
PAYMENT_BASE_URL=http://localhost:3001

# --- Payout ledger (Phase 3) ---
# Lifetime (days) of the creator's payout confirm/dispute magic-link token. The
# raw token lives only in the "you've been paid" email; the DB stores its sha256
# hash + this expiry. After it lapses, the confirm/dispute links show a friendly
# "link expired — contact your brand" page. Default 7.
PAYOUT_CONFIRM_TTL_DAYS=7
# Lifetime (days) of the hosted payout-info (payment form) magic-link token,
# minted into the payment email. Same sha256-hash + expiry pattern. Default 7.
PAYMENT_TOKEN_TTL_DAYS=7
# A payout the brand marked SENT that the creator neither confirms nor disputes
# auto-settles this many days after it was sent (the scheduler sweep, which runs
# under the leader lease). Default 7. This is intentionally NOT a lazy GET-time
# settle — money only settles from the background job.
PAYOUT_AUTO_SETTLE_DAYS=7

# --- Brand-approval gate ---
# When true, a creator who ACCEPTS on a local_payment execution is HELD in
# AWAITING_BRAND_APPROVAL and the brand is emailed an Approve/Reject magic link
# BEFORE the content brief + payout link go out. On Approve the brief is released
# (→ PAYMENT_PENDING); on Reject the deal halts to MANUAL_REVIEW. OFF by default,
# so the post-acceptance flow is unchanged (brief sent immediately on ACCEPT). The
# flag is read at ACCEPT time only, so flipping it never re-gates an in-flight run.
BRAND_APPROVAL_GATE_ENABLED=false
# Lifetime (days) of the brand's approve/reject magic-link token. Same sha256-hash
# + expiry pattern as the payout tokens; the raw token lives only in the brand
# email. Default 14.
BRAND_APPROVAL_TTL_DAYS=14

# --- Structured brief parsing (PLU-107) ---
# When true, the agent's /parse-brief segments the campaign brief PDF into typed,
# page-referenced sections with an explicit status (ok | empty | parse_failed) that
# finally distinguishes an ABSENT section from a PARSE FAILURE, and returns them
# alongside the flat text. OFF by default → /parse-brief returns flat text only,
# byte-identical to today. Deterministic segmentation only (no vector DB). This is
# an AGENT-side flag (set it in the agent's environment).
STRUCTURED_BRIEF_PARSING_ENABLED=false
# When true, the parsed brief's flat text is ALSO threaded into the /negotiate
# DECISION model (not just the /draft copywriter) on knowledge turns, so the model
# that decides can ANSWER a usage/timeline/exclusivity question from real campaign
# data instead of deferring. Independent sub-flag so structured parsing can ship and
# be validated before the decision-prompt change flips on. OFF by default → the
# /negotiate prompt is byte-identical to today; the brief still reaches /draft. The
# brief is reference DATA on both endpoints — never a money input.
BRIEF_INTO_NEGOTIATE=false

# --- Campaign-knowledge retrieval (PLU-114) ---
# When true, a DETERMINISTIC keyword/regex router selects ONLY the campaign-
# knowledge sections relevant to the current creator turn (their message + open
# obligations) and threads just those into the /negotiate and /draft prompts,
# instead of dumping all four flat facts + the whole 4000-char brief blob every
# turn. No vector DB, no embeddings, no model call — pure section selection.
# On a confident match it REPLACES the flat knowledge blocks; on a no-match it
# falls back to today's flat blocks (so a too-conservative router degrades to
# current behavior, never a regression). A selected-but-unconfigured section
# defers honestly — it never invents a value; retrieval never moves a dollar
# figure or a decision (topic_gate still owns escalation, before retrieval runs).
# OFF by default → both prompts are byte-identical to today and no retrieval
# record is emitted. AGENT-side flag (set it in the agent's environment). Every
# retrieval logs which sections were selected, why, and where each resolved from
# (section keys/rules/ids only — never the section VALUES).
#
# RECOMMENDED PAIRING (Calvin follow-up §4.2): enable this together with
# STRUCTURED_BRIEF_PARSING_ENABLED=true. Per-section brief resolution reads the
# structured `briefSections` the server threads only when parsing is on; with
# retrieval on but parsing off, the router still resolves from the flat campaign
# fields and safely degrades to the full-brief fallback for anything it can't
# resolve (it never emits a false "we'll confirm" while the answer sits in the
# flat brief blob), but it loses per-section granularity. The agent logs a
# one-time startup WARNING when it detects retrieval-on / parsing-off.
KNOWLEDGE_RETRIEVAL_ENABLED=false

# --- Campaign-knowledge topic classifier (PLU-114 W8, Calvin follow-up §5) ---
# OPTIONAL Phase-2 fallback for the deterministic router above. When true, a SMALL
# constrained LLM classifier runs ONLY on the uncertain path — after the
# deterministic keyword/regex router returns no_match or a low-confidence match —
# to recover creator questions the regexes miss on PARAPHRASE ("what does the
# compensation look like?", "am I able to work with your rivals?"). It NEVER runs
# on the confident deterministic fast path.
#
# HARD INVARIANT: the classifier returns ONLY topic keys from a CLOSED schema
# (paymentTerms | usageRights | exclusivity | deliverables | timeline | shipping |
# attributionWindow | broad | unknown) plus a coarse high/low confidence. It does
# NOT generate campaign values, rates, or decisions — the section VALUES are still
# resolved DETERMINISTICALLY from the authoritative flat fields / brief sections,
# exactly as the regex path does. "Retrieval is a noise reducer, never a source of
# truth" is unchanged. unknown / broad-that-resolves-to-nothing / low confidence /
# any model error → the same full-context fallback (never a narrowed prompt), so an
# uncertain classifier can only ever ADD recall, never starve the model.
#
# REQUIRES KNOWLEDGE_RETRIEVAL_ENABLED=true (it is a fallback *within* retrieval).
# OFF by default → the module never enters a hot path; the deterministic router is
# byte-identical to retrieval-only. Ship + validate the deterministic path first;
# turn this on only when the retrieval observability shows real questions the regex
# router misses. Uses the `knowledge_classifier` LLM role, so it can point at a
# cheap/fast model independently: e.g. LLM_PROVIDER_KNOWLEDGE_CLASSIFIER=deepseek.
KNOWLEDGE_CLASSIFIER_ENABLED=false

# --- Logging / observability (P9) ---
# Log-to-file sink: when set, every console line (incl. the structured
# [transition]/[trace]/[metrics] lines, worker failures, escalation errors) is
# ALSO appended to a file so the live log is readable when the server runs
# detached / behind a tunnel. stdout is unchanged; unset = stdout-only (no-op).
#   LOG_FILE  explicit file path
#   LOG_DIR   a directory → appends <dir>/server.log (ignored if LOG_FILE set)
# LOG_FILE=/var/log/pluvus/server.log
# LOG_DIR=/var/log/pluvus
# Metrics backstop (HARD-S1): a non-terminal instance whose updatedAt is older
# than this (ms) is counted "stuck" in worker metrics + the P9 alerts roll-up.
# Default 1800000 (30 min).
# STUCK_STATE_AGE_MS=1800000
# Harness-only: persist LlmCall telemetry rows during harness runs. Leave unset
# in normal operation (the live path persists automatically).
# LLM_USAGE_PERSIST=

# ============================================================
# --- LLM provider (agent service) ---
# LLM_PROVIDER is the GLOBAL default backing every LangGraph agent. No code edits.
#   LLM_PROVIDER=anthropic  → Claude (default) — set ANTHROPIC_API_KEY below
#   LLM_PROVIDER=deepseek   → DeepSeek cloud — set DEEPSEEK_API_KEY below
#   LLM_PROVIDER=ollama     → local Qwen via Ollama (dev/testing, no API key)
LLM_PROVIDER=ollama
# Optional failover (FIX-8): if the primary provider fails on a call, fall over
# to this one. Leave blank for no failover (the common case). Configure the
# fallback's own model/key env below. Example: LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=

# Per-TASK provider override (mixed-model deployment). Each role — negotiate,
# classify, draft — pins its OWN provider via LLM_PROVIDER_<ROLE>, inheriting
# LLM_PROVIDER above when blank. Each role also honors LLM_FALLBACK_PROVIDER_<ROLE>.
# Example split: Claude on the money/decision path, DeepSeek for email copy:
#   LLM_PROVIDER_NEGOTIATE=   (blank → inherits LLM_PROVIDER)
#   LLM_PROVIDER_CLASSIFY=    (blank → inherits LLM_PROVIDER)
#   LLM_PROVIDER_DRAFT=deepseek
LLM_PROVIDER_DRAFT=

# Negotiation decision engine.
#   NEGOTIATION_STRATEGY=rules  → deterministic (model classifies + extracts,
#                                 code picks accept/counter/escalate + the number)
#   NEGOTIATION_STRATEGY=llm    → the model reads the full history and picks the
#                                 action AND rate itself, bounded to [floor,
#                                 ceiling] + round cap; falls back to rules on any
#                                 LLM/transport failure.
NEGOTIATION_STRATEGY=llm

# OpenRouter (hosted prod path, P4) — used when LLM_PROVIDER=openrouter. ONE key
# proxies many upstreams; you pick the model by SLUG per role. Rides
# langchain-openai (already installed). Set OPENROUTER_API_KEY and restart.
# ⚠ VERIFY slugs on https://openrouter.ai/models before a paid run — they get
# renamed (e.g. deepseek/deepseek-chat-v3 → the deepseek-v4-* family).
OPENROUTER_API_KEY=
#   OPENROUTER_MODEL        global default → negotiate + classify (money path)
#   OPENROUTER_MODEL_DRAFT  drafting only → cheaper copy model
OPENROUTER_MODEL=anthropic/claude-opus-4.8
OPENROUTER_MODEL_DRAFT=anthropic/claude-opus-4.8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override only for a proxy
# OPENROUTER_MAX_TOKENS=768

# P4 spend guards. Dormant on local Ollama (cost = $0); set on a hosted paid run.
#   LLM_MAX_REQUEST_COST_USD   per-REQUEST hard cap: a request whose running
#     estimated cost crosses this stops mid-flight (agent → 503) so one runaway
#     negotiation loop can't rack up an unbounded bill. 0/unset = off.
#   LLM_DAILY_SPEND_ALERT_USD  daily MONITOR: /observability/llm reports
#     spendGuard.exceeded=true once trailing-24h estimated spend crosses it. Does
#     NOT block calls — it's the signal an alert reads (P9). Unset = monitor off.
LLM_MAX_REQUEST_COST_USD=0
# LLM_DAILY_SPEND_ALERT_USD=25

# Anthropic / Claude (prod) — used when LLM_PROVIDER=anthropic (default)
# Steps to run: (1) pip install langchain-anthropic  (2) set ANTHROPIC_API_KEY
#   (3) restart the agent service. ANTHROPIC_MODEL is itself the pin — use an
# exact model id from the Claude catalog:
#   claude-opus-4-8   → most capable (default)
#   claude-haiku-4-5  → fastest + cheapest
#   claude-sonnet-4-6 → balanced
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
# Optional Claude knobs (sane defaults; override only if needed):
#   ANTHROPIC_MAX_TOKENS      cap on generated tokens (default 768; negotiate route
#                             passes a larger per-call override for its long JSON)
#   ANTHROPIC_TIMEOUT_SECONDS per-request SDK timeout (default 60)
#   ANTHROPIC_MAX_RETRIES     SDK auto-retries on 429/5xx (default 2)
# ANTHROPIC_MAX_TOKENS=768

# DeepSeek (cloud) — used when a provider slot resolves to deepseek (e.g.
# LLM_PROVIDER_DRAFT=deepseek). OpenAI-compatible, so it rides langchain-openai
# (already installed). Steps: set DEEPSEEK_API_KEY (platform.deepseek.com) and
# restart the agent. DEEPSEEK_MODEL is the pin:
#   deepseek-chat     → V3, strong + cheap for email copy (default)
#   deepseek-reasoner → R1, only if a path needs a visible chain of thought
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Optional DeepSeek knobs (sane defaults; override only if needed):
#   DEEPSEEK_BASE_URL         default https://api.deepseek.com (override for a proxy)
#   DEEPSEEK_MAX_TOKENS       cap on generated tokens (default 768)
#   DEEPSEEK_TIMEOUT_SECONDS  per-request SDK timeout (default 60)
#   DEEPSEEK_MAX_RETRIES      SDK auto-retries on 429/5xx (default 2)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (local dev) — used when LLM_PROVIDER=ollama
# qwen3:8b is the practical local default: on a 6GB GPU it runs mostly on the GPU
# (~5.2GB), so generation is 5-10x faster than the 30B MoE (19GB, ~75% spills to
# CPU). The AGENT_TIMEOUT_MS / LLM_INVOKE_TIMEOUT_SECONDS above are sized for it.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Optional (FIX-8): pin Ollama to an immutable build digest so a later
# `ollama pull` of the same tag can't silently change the decision path. Get it
# from `ollama show qwen3:8b`. Accepts "sha256:<hex>" or bare "<hex>".
OLLAMA_MODEL_DIGEST=
# ============================================================
